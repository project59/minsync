{
  "name": "minsync",
  "version": "1.0.1",
  "description": "One-way incremental Android backup via ADB",
  "main": "main.js",
  "desktopName": "minsync",
  "author": {
    "name": "Project59",
    "email": "project59@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/project59/minsync.git"
  },
  "scripts": {
    "postinstall": "node scripts/download-adb.js",
    "start": "electron .",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "vite build",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "preview": "vite preview"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@tailwindcss/vite": "^4.3.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "vite": "^6.0.7",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.project59.minsync",
    "productName": "MinSync",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist-renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/adb",
        "to": "bin/adb"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "executableName": "minsync",
      "syncDesktopName": true
    },
    "publish": {
      "provider": "github",
      "owner": "project59",
      "repo": "minsync"
    }
  }
}
